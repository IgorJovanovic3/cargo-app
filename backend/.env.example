# Copy to .env locally. Never commit .env or real credentials.
# Generate a key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local demo. For hosted PostgreSQL, supply DATABASE_URL through the host.
# Add ?sslmode=require to the PostgreSQL URL when required by the provider.
DATABASE_URL=sqlite:///./cargo_app.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional email; disabled until sender credentials are supplied.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# Off for ordinary local use. Public demo uses a separate disposable database.
DEMO_MODE=false
SERVE_FRONTEND=false
