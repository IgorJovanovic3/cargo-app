{
  "$schema": "https://railway.app/railway.schema.json",
  "builds": [
    {
      "src": "backend",
      "use": "@railway/python",
      "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
    },
    {
      "src": "frontend",
      "use": "@railway/static",
      "buildCommand": "npm install && npm run build"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/*",
      "dest": "/"
    }
  ]
}